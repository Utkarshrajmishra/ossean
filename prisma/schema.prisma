// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account{
  id String @default(uuid()) @unique @id
  name String
  email String @unique
  image String?

  User User[]
}

model User{
  userName String @unique
  id String @unique @id
  account Account @relation(fields: [id], references: [id])
  bio String?
  buttonStyle String @default("rounded-md")
  theme Int @default(1)

  Link Link[]
}



model Link{
  id String @id @default(uuid())
  url String
  title String
  archived Boolean @default(false)
  isSocial Boolean @default(false)
  social Int @default(0)
  clicks Int @default(0)
  userId String
  User User @relation(fields: [userId], references: [id])

  @@index([userId])
}